# ─────────────────────────────────────────────────────────────
# Mesa de Ayuda ExperTIC — variables de entorno
# Copia este archivo a .env.local y completa los valores.
# Se validan al arrancar (src/env.ts): si falta una obligatoria, la app no inicia.
# ─────────────────────────────────────────────────────────────

# Base de datos (Neon). Ver docs/BASE_DE_DATOS.md
DATABASE_URL=                 # Cadena POOLED (host con -pooler). La usa la app.
DATABASE_URL_UNPOOLED=        # Cadena DIRECTA (sin -pooler). La usan migraciones y semilla.

# Autenticación (Better Auth)
BETTER_AUTH_SECRET=           # Genera uno con: openssl rand -base64 32  (mínimo 32 caracteres)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dominios de correo permitidos para registrarse, separados por coma.
# Vacío = cualquier dominio (decisión D-001).
ALLOWED_EMAIL_DOMAINS=

# Primer administrador (lo crea `pnpm db:seed`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=          # Mínimo 8 caracteres

# Archivos adjuntos
STORAGE_DRIVER=local          # local | vercel-blob
BLOB_READ_WRITE_TOKEN=        # Solo si STORAGE_DRIVER=vercel-blob

# Correo
EMAIL_DRIVER=console          # console (imprime en consola) | brevo | resend
BREVO_API_KEY=                # Solo si EMAIL_DRIVER=brevo (gratis, sin dominio propio)
RESEND_API_KEY=               # Solo si EMAIL_DRIVER=resend
EMAIL_FROM="Mesa de Ayuda ExperTIC <no-responder@tu-dominio>"

# Tareas programadas (Vercel Cron envía este valor como Bearer token)
CRON_SECRET=                  # Mínimo 16 caracteres

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Solo pruebas E2E: sube el límite de inicios de sesión por minuto. Nunca en producción.
E2E_RELAXED_RATE_LIMIT=0
